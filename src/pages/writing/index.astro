---
import Page from '../../layouts/Page.astro';
import { getCollection } from 'astro:content';

const title = 'Writing — Pushkar Kumar';
const description =
  'Notes on measurement, failure, and what the numbers actually say.';

const posts = (await getCollection('writing'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Page title={title} description={description}>
  <section class="wrap section">
    <h1>Writing</h1>
    <p class="label subtitle">
      Notes on measurement, failure, and what the numbers actually say
    </p>

    {
      posts.length > 0 && (
        <div class="post-list">
          {posts.map((post) => {
            const formatted = post.data.date.toLocaleDateString('en-GB', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            });

            return (
              <article class="row">
                <h2>
                  <a href={`/writing/${post.id}/`}>{post.data.title}</a>
                </h2>
                <p class="desc">{post.data.description}</p>
                <time class="label date" datetime={post.data.date.toISOString().slice(0, 10)}>{formatted}</time>
              </article>
            );
          })}
        </div>
      )
    }
  </section>
</Page>

<style>
  .subtitle {
    margin-block-start: var(--s-4);
  }

  .post-list {
    margin-block-start: var(--s-12);
  }

  .row {
    padding-block: var(--s-6);
    border-top: var(--hairline);
  }

  .row h2 {
    font-size: var(--step-2);
    max-width: 28ch;
  }

  .row h2 a {
    text-decoration: none;
  }

  .row h2 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--ink-3);
    text-underline-offset: 0.15em;
  }

  .desc {
    color: var(--ink-2);
    margin-block-start: var(--s-2);
    max-width: 54ch;
  }

  .date {
    display: block;
    margin-block-start: var(--s-3);
  }
</style>
