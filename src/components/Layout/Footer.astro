---
const year = new Date().getFullYear();

const links = [
  { href: 'https://github.com/Pushkar0997', label: 'GitHub' },
  { href: 'https://huggingface.co/PushkarKumar', label: 'Hugging Face' },
  {
    href: 'https://linkedin.com/in/pushkar-kumar-aaa96a301',
    label: 'LinkedIn',
  },
];
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div>
      <p class="label">Contact</p>
      <p class="email">
        <a href="mailto:pushkarkumar0997@gmail.com"
          >pushkarkumar0997@gmail.com</a
        >
      </p>
    </div>

    <nav aria-label="Elsewhere">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} rel="me noopener">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="label colophon">Pune, India · {year}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--hairline);
    margin-block-start: var(--s-24);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-8);
    padding-block: var(--s-12);
  }

  .email {
    font-size: var(--step-1);
    margin-block-start: var(--s-2);
  }

  .email a {
    text-decoration-color: var(--line-faint);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    font-family: var(--font-mono);
    font-size: var(--label);
    letter-spacing: var(--label-track);
    text-transform: uppercase;
    color: var(--ink-3);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  nav a:hover {
    color: var(--ink);
    border-bottom-color: var(--line-faint);
  }

  .colophon {
    margin: 0;
  }
</style>
