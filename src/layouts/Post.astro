---
import Page from './Page.astro';

/* A single prose column, centred. No margin column — posts are
   not claims to be annotated, they are notes to be read. */

interface Props {
  title: string;
  description: string;
  date: Date;
}

const { title, description, date } = Astro.props;

const formatted = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Page title={`${title} — Pushkar Kumar`} description={description}>
  <article class="wrap post">
    <header>
      <p class="label breadcrumb">
        <a href="/writing/">Writing</a>
      </p>

      <h1>{title}</h1>

      <time class="label date" datetime={date.toISOString().slice(0, 10)}>{formatted}</time>
    </header>

    <div class="prose-col">
      <slot />
    </div>
  </article>
</Page>

<style>
  .post {
    padding-block: var(--s-12) var(--s-16);
    max-width: var(--width-prose);
  }

  .breadcrumb {
    margin: 0;
  }

  .breadcrumb a {
    color: inherit;
  }

  h1 {
    font-size: var(--step-4);
    max-width: 22ch;
    margin-block-start: var(--s-6);
  }

  .date {
    display: block;
    margin-block-start: var(--s-4);
  }

  /* ── Prose — same treatment as CaseStudy ─────────────────── */

  .prose-col {
    max-width: var(--width-prose);
    margin-block-start: var(--s-12);
  }

  .prose-col :global(h2) {
    font-size: var(--step-2);
    margin-block-start: var(--s-12);
    padding-block-start: var(--s-4);
    border-top: var(--hairline);
    max-width: 28ch;
  }

  .prose-col :global(h2:first-child) {
    margin-block-start: 0;
    padding-block-start: 0;
    border-top: 0;
  }

  .prose-col :global(p) {
    margin-block-start: var(--s-4);
  }

  .prose-col :global(ul),
  .prose-col :global(ol) {
    margin-block-start: var(--s-4);
    max-width: var(--measure);
  }

  .prose-col :global(li + li) {
    margin-block-start: var(--s-2);
  }

  .prose-col :global(strong) {
    font-weight: 500;
  }

  .prose-col :global(code) {
    background: var(--surface);
    padding: 0.1em 0.35em;
    border: var(--hairline);
  }

  .prose-col :global(blockquote) {
    margin: var(--s-8) 0 0;
    padding-inline-start: var(--s-6);
    border-inline-start: 2px solid var(--line-strong);
    color: var(--ink-2);
    font-style: italic;
  }

  .prose-col :global(blockquote p) {
    margin-block-start: var(--s-4);
  }

  .prose-col :global(blockquote p:first-child) {
    margin-block-start: 0;
  }

  .prose-col :global(table) {
    margin-block-start: var(--s-8);
  }

  @media (min-width: 900px) {
    .post {
      padding-block: var(--s-16) var(--s-24);
    }
  }
</style>
